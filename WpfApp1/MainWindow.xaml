<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Приём товара по накладным" Height="640" Width="1100"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Панель кнопок -->
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnOpen" Content="1. Открыть файл накладных" Padding="12,6" Margin="0,0,8,0"
                    Click="BtnOpen_Click"/>
            <Button x:Name="btnAccept" Content="2. Принять товар" Padding="12,6" Margin="0,0,8,0"
                    IsEnabled="False" Click="BtnAccept_Click"/>
            <Button Content="Обновить" Padding="12,6" Margin="0,0,16,0" Click="BtnRefresh_Click"/>
            <TextBlock x:Name="txtFree" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <!-- Склады -->
        <GroupBox Grid.Row="1" Header="Склады (выберите склад, чтобы увидеть его содержимое)" Margin="0,0,8,8">
            <DataGrid x:Name="gridWarehouses" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionChanged="GridWarehouses_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Код" Binding="{Binding Id}" Width="45"/>
                    <DataGridTextColumn Header="Склад" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Вместимость, уп." Binding="{Binding Capacity}" Width="115"/>
                    <DataGridTextColumn Header="Занято, уп." Binding="{Binding Used}" Width="90"/>
                    <DataGridTextColumn Header="Свободно, уп." Binding="{Binding Free}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Содержимое выбранного склада -->
        <GroupBox x:Name="boxContents" Grid.Row="2" Header="Содержимое склада" Margin="0,0,8,0">
            <DataGrid x:Name="gridContents" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Товар" Binding="{Binding Product}" Width="*"/>
                    <DataGridTextColumn Header="Количество, уп." Binding="{Binding Qty}" Width="110"/>
                    <DataGridTextColumn Header="Накладная" Binding="{Binding Invoice}" Width="90"/>
                    <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Загруженные накладные -->
        <GroupBox Grid.Row="1" Grid.Column="1" Header="Накладные из файла" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock x:Name="txtFile" DockPanel.Dock="Top" Margin="0,0,0,5" TextWrapping="Wrap"
                           Text="Файл не выбран"/>
                <ListBox x:Name="listItems"/>
            </DockPanel>
        </GroupBox>

        <!-- Журнал приёма -->
        <GroupBox Grid.Row="2" Grid.Column="1" Header="Журнал приёма">
            <TextBox x:Name="txtLog" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
        </GroupBox>
    </Grid>
</Window>
