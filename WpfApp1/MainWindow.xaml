<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Студенты (ADO.NET)" Height="500" Width="850"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Поиск -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Поиск по фамилии:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtSearch" Width="200" Margin="0,0,5,0"/>
            <Button Content="Найти" Width="80" Click="BtnSearch_Click" Margin="0,0,5,0"/>
            <Button Content="Показать всех" Width="100" Click="BtnLoad_Click"/>
        </StackPanel>

        <!-- Таблица -->
        <DataGrid x:Name="dgStudents" Grid.Row="1" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="DgStudents_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id"       Binding="{Binding Id}" Width="40"/>
                <DataGridTextColumn Header="Фамилия"  Binding="{Binding LastName}" Width="*"/>
                <DataGridTextColumn Header="Имя"      Binding="{Binding FirstName}" Width="*"/>
                <DataGridTextColumn Header="Группа"   Binding="{Binding GroupName}" Width="80"/>
                <DataGridTextColumn Header="Дата рождения"
                                    Binding="{Binding BirthDate, StringFormat=dd.MM.yyyy}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Форма редактирования -->
        <StackPanel Grid.Column="1" Grid.Row="1" Margin="10,0,0,0">
            <TextBlock Text="Фамилия"/>
            <TextBox x:Name="txtLastName" Margin="0,0,0,8"/>
            <TextBlock Text="Имя"/>
            <TextBox x:Name="txtFirstName" Margin="0,0,0,8"/>
            <TextBlock Text="Группа"/>
            <TextBox x:Name="txtGroup" Margin="0,0,0,8"/>
            <TextBlock Text="Дата рождения"/>
            <DatePicker x:Name="dpBirth" Margin="0,0,0,15"/>

            <Button Content="Добавить" Click="BtnAdd_Click"    Margin="0,0,0,5" Height="30"/>
            <Button Content="Изменить" Click="BtnUpdate_Click" Margin="0,0,0,5" Height="30"/>
            <Button Content="Удалить"  Click="BtnDelete_Click" Margin="0,0,0,5" Height="30"/>
            <Button Content="Очистить поля" Click="BtnClear_Click" Height="30"/>
        </StackPanel>
    </Grid>
</Window>
