<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
  <connectionStrings>
    <!-- Data Source = имя сервера из окна входа SSMS (в лаборатории, например, lab215-16) -->
    <add name="SQLServerConnection"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=Склад;Integrated Security=True"
         providerName="System.Data.SqlClient"/>
  </connectionStrings>
</configuration>
